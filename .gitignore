# 环境变量配置文件
.env

# 看典古籍OCR输出文件
kandian_ocr/images/*
kandian_ocr/outputs/*
kandian_ocr/characters/*

# 保留目录结构（保留.gitkeep文件）
!kandian_ocr/images/.gitkeep
!kandian_ocr/outputs/.gitkeep
!kandian_ocr/characters/.gitkeep

# 通用输出目录
**/outputs/*
!**/outputs/.gitkeep

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

doubao_api/outputs/*
doubao_api/characters_test/*