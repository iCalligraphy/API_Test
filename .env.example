# ==========================================
# 看典古籍OCR API 配置
# ==========================================
# API文档: https://www.kandianguji.com/api_documentation
# 申请地址: https://ocr.kandianguji.com

# API Token - 用户身份标识符，在看典古籍网站申请获取
Token="your-kandian-token-here"

# Email - 申请API Token的账号（手机号注册的填写手机号）
Email="your-email-or-phone-here"

# 可用额度说明: 每日最多申请2000次，超过需付费（每2000次 20元）


# ==========================================
# 豆包大模型 API 配置
# ==========================================
# API文档: https://www.volcengine.com/docs/82379/1263512
# 控制台: https://console.volcengine.com/ark

# 豆包 API Key - 从火山方舟平台获取
ARK_API_KEY="your-ark-api-key-here"

# API Base URL - 根据业务所在地域配置（可选，默认值如下）
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# 模型ID - 推理接入点ID，在控制台创建（文本模型）
ARK_MODEL="doubao-1-5-thinking-pro-250415"

# 视觉模型ID - 用于图像理解任务（书法笔迹分析等）
# 注意：视觉模型需要在火山方舟控制台创建对应的推理接入点
ARK_VISION_MODEL="doubao-1.5-vision-pro-32k-250115"

# 图像编辑模型ID - 用于在原书法图片上添加结构标注
ARK_IMAGE_MODEL="doubao-seededit-3-0-i2i-250628"
